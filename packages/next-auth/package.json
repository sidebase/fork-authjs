{
  "name": "@sidebase/fork-authjs",
  "version": "4.24.15-next.1",
  "description": "Authentication for Nuxt",
  "homepage": "https://authjs.dev",
  "repository": "https://github.com/sidebase/fork-authjs.git",
  "author": "Iain Collins <me@iaincollins.com>",
  "contributors": [
    "Balázs Orbán <info@balazsorban.com>",
    "Nico Domino <yo@ndo.dev>",
    "Lluis Agusti <hi@llu.lu>",
    "Thang Huu Vu <hi@thvu.dev>"
  ],
  "main": "index.js",
  "module": "index.js",
  "types": "index.d.ts",
  "keywords": [
    "vue",
    "nodejs",
    "oauth",
    "jwt",
    "oauth2",
    "authentication",
    "nuxt",
    "csrf",
    "oidc",
    "nextauth"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./adapters": {
      "types": "./adapters.d.ts"
    },
    "./core": {
      "types": "./core/index.d.ts",
      "default": "./core/index.js"
    },
    "./css": {
      "types": "./css/index.d.ts",
      "default": "./css/index.js"
    },
    "./jwt": {
      "types": "./jwt/index.d.ts",
      "default": "./jwt/index.js"
    },
    "./providers/*": {
      "types": "./providers/*.d.ts",
      "default": "./providers/*.js"
    }
  },
  "scripts": {
    "build": "pnpm clean && pnpm build:js && pnpm build:css",
    "build:js": "pnpm clean && pnpm generate-providers && pnpm tsc --project tsconfig.build.json",
    "clean": "rm -rf coverage client css utils providers core jwt react next lib ./*.js ./*.ts*",
    "build:css": "postcss --config config/postcss.config.js src/**/*.css --base src --dir . && node config/wrap-css.js",
    "dev": "pnpm clean && pnpm generate-providers && concurrently \"pnpm watch:css\" \"pnpm watch:ts\"",
    "watch:ts": "pnpm tsc --project tsconfig.dev.json",
    "watch:css": "postcss --config config/postcss.config.js --watch src/**/*.css --base src --dir .",
    "test": "jest --config ./config/jest.config.js",
    "prepublishOnly": "pnpm build",
    "generate-providers": "node ./config/generate-providers.js",
    "lint": "eslint src config tests eslint.config.cjs",
    "typecheck": "pnpm typecheck:src && pnpm typecheck:tests",
    "typecheck:src": "tsc --project tsconfig.build.json --noEmit",
    "typecheck:tests": "tsc --project tsconfig.test.json"
  },
  "files": [
    "client",
    "core",
    "css",
    "jwt",
    "lib",
    "next",
    "providers",
    "react",
    "src",
    "utils",
    "*.d.ts*",
    "*.js"
  ],
  "license": "ISC",
  "dependencies": {
    "cookie": "^0.7.0",
    "jose": "^4.15.5",
    "oauth": "^0.9.15",
    "openid-client": "^5.4.0"
  },
  "peerDependencies": {
    "nodemailer": "^10.0.9",
    "vue": "^3.5.30"
  },
  "peerDependenciesMeta": {
    "nodemailer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@edge-runtime/jest-environment": "1.1.0-beta.35",
    "@eslint/js": "10.0.1",
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.21",
    "@types/jest": "^28.1.3",
    "@types/node": "^24.19.2",
    "@types/oauth": "^0.9.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^7",
    "cssnano": "^5.1.15",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "jest": "^28.1.1",
    "jest-watch-typeahead": "^1.1.0",
    "pkg-pr-new": "^0.0.75",
    "postcss": "^8.5.30",
    "postcss-cli": "^9.1.0",
    "postcss-nested": "^5.0.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.71.2",
    "vue": "^3.5.44"
  }
}
